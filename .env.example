# Copy to .env and fill in. Never commit .env.
# With nothing set, the system runs on the offline mock provider.
#
# Pick ONE of the two options below.
# Selection order: --offline > AP_PROVIDER / --provider > LLM_BASE_URL > XAI_API_KEY > mock.

# --- Option 1: Grok (the case's specified engine) ----------------------------------
XAI_API_KEY=

# Grok wire format: "responses" (default; what xAI's docs describe, falls back to chat
# completions on a 404) or "chat" to force chat completions.
# GROK_API=responses
# Defaults: grok-4.7 (approver, critic), grok-4.20-0309-non-reasoning (extractor, notifier).

# --- Option 2: any OpenAI-compatible endpoint --------------------------------------
# OpenAI, Anthropic's compatibility layer, Gemini's, Groq, Together, OpenRouter, or a
# local server such as Ollama or vLLM. A base URL takes precedence over XAI_API_KEY.
# LLM_BASE_URL=https://api.openai.com/v1/        # or http://localhost:11434/v1 for Ollama
# LLM_API_KEY=                                   # optional for local servers
# LLM_MODEL=                                     # used for every role
# LLM_API=chat                                   # "chat" (default) or "responses"
# LLM_EXTRA_HEADERS={"some-header": "value"}     # optional JSON; e.g. a workspace id header
#
# If the endpoint rejects tool calling (some local models), the system falls back to plain
# JSON replies. The approver then decides without lookups, so expect more escalations.

# --- Either option ------------------------------------------------------------------
# Optional: a different model for one role (a stronger one for judgment, a cheaper one for
# extraction), overriding the defaults above.
# AP_MODEL_APPROVER=
# AP_MODEL_CRITIC=
# AP_MODEL_EXTRACTOR=
# AP_MODEL_NOTIFIER=

# Optional: set to an empty value to omit temperature (default 0 for repeatability).
# AP_TEMPERATURE=0

# Optional: enable a dollar estimate in reports (price per million tokens).
# AP_PRICE_IN_PER_MTOK=
# AP_PRICE_OUT_PER_MTOK=

# Fixed "today" for past-due checks so runs are reproducible.
# AP_AS_OF_DATE=2026-02-01
