# Copy to .env and fill in. Never commit .env.
# With no key set, the system runs on the offline mock provider.
# Provider: grok (default when XAI_API_KEY is set) or mock.
# AP_PROVIDER=grok
XAI_API_KEY=

# Optional: model per role (defaults are in invoice_ap/llm.py).
# AP_MODEL_APPROVER=grok-4.7
# AP_MODEL_CRITIC=grok-4.7
# AP_MODEL_EXTRACTOR=grok-4.20-0309-non-reasoning
# AP_MODEL_NOTIFIER=grok-4.20-0309-non-reasoning

# Optional: set to an empty value to omit temperature (default 0 for repeatability).
# AP_TEMPERATURE=0

# Optional: enable a dollar estimate in reports (price per million tokens).
# AP_PRICE_IN_PER_MTOK=
# AP_PRICE_OUT_PER_MTOK=

# Fixed "today" for past-due checks so runs are reproducible.
# AP_AS_OF_DATE=2026-02-01
